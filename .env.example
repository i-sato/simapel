APP_NAME=SIMAPEL
APP_ENV=local
APP_KEY=
# Wajib false di production.
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=simapel
DB_USERNAME=simapel
# Diisi acak oleh `make setup`. Jangan memakai kata sandi bersama/default.
DB_PASSWORD=
# Hanya dipakai container MySQL lokal (compose.yaml).
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Wajib true di production (HTTPS).
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@simapel.local"
MAIL_FROM_NAME="${APP_NAME}"

# Daftar IP reverse proxy tepercaya dipisah koma. Kosongkan bila tidak ada proxy.
TRUSTED_PROXIES=

# Pembatasan percobaan login per kombinasi NIP + IP.
SIMAPEL_LOGIN_MAX_ATTEMPTS=5
SIMAPEL_LOGIN_DECAY_SECONDS=300

# --- Docker (lokal) ---
APP_PORT=8080
FORWARD_DB_PORT=3307
ADMINER_PORT=8081
HOST_UID=1000
HOST_GID=1000

# --- Pengujian E2E (hanya lokal/CI) ---
# Kata sandi akun E2E dibuat acak per eksekusi oleh `make e2e`; tidak disimpan di file.
E2E_NIP=999900000000000001
