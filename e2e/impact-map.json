{
    "description": "Peta file sumber -> tag area UI Playwright. Dipakai `make e2e-affected` dan CI agar hanya UI terdampak yang diuji. Tag '*' berarti semua area. Perbarui peta ini setiap menambah modul/halaman baru. Tag kosong ([]) berarti file sudah dipetakan tetapi tidak memengaruhi UI.",
    "alwaysRunTags": [
        "@setup"
    ],
    "rules": [
        {
            "pattern": "resources/views/layouts/**",
            "tags": [
                "*"
            ]
        },
        {
            "pattern": "resources/views/partials/**",
            "tags": [
                "*"
            ]
        },
        {
            "pattern": "public/css/**",
            "tags": [
                "*"
            ]
        },
        {
            "pattern": "public/js/**",
            "tags": [
                "*"
            ]
        },
        {
            "pattern": "app/Http/Middleware/**",
            "tags": [
                "*"
            ]
        },
        {
            "pattern": "app/Providers/**",
            "tags": [
                "*"
            ]
        },
        {
            "pattern": "bootstrap/**",
            "tags": [
                "*"
            ]
        },
        {
            "pattern": "routes/web.php",
            "tags": [
                "*"
            ]
        },
        {
            "pattern": "config/**",
            "tags": [
                "*"
            ]
        },
        {
            "pattern": "lang/**",
            "tags": [
                "*"
            ]
        },
        {
            "pattern": "database/migrations/**",
            "tags": [
                "*"
            ]
        },
        {
            "pattern": "database/seeders/E2eSeeder.php",
            "tags": [
                "*"
            ]
        },
        {
            "pattern": "composer.lock",
            "tags": [
                "*"
            ]
        },
        {
            "pattern": "compose.yaml",
            "tags": [
                "*"
            ]
        },
        {
            "pattern": "docker/**",
            "tags": [
                "*"
            ]
        },
        {
            "pattern": "e2e/playwright.config.ts",
            "tags": [
                "*"
            ]
        },
        {
            "pattern": "e2e/package*.json",
            "tags": [
                "*"
            ]
        },
        {
            "pattern": "e2e/support/**",
            "tags": [
                "*"
            ]
        },
        {
            "pattern": "e2e/tests/*.setup.ts",
            "tags": [
                "*"
            ]
        },
        {
            "pattern": "resources/views/auth/**",
            "tags": [
                "@auth"
            ]
